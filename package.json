{
  "name": "forma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local workbench for a one-brace truss experiment and independent package comparison.",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:structures": "node scripts/benchmark-structures.mjs",
    "prepare:report-qa": "node scripts/prepare-report-qa.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite preview --host 127.0.0.1",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
